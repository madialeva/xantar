{
  "name": "xantar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Juego Phaser en TypeScript con Vite",
  "author": "Xantar",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "smoke": "npm run build && npm run build:electron && node scripts/smoke.mjs",
    "build:desktop": "npm run typecheck && npm run build && npm run build:electron && electron-builder",
    "build:desktop:dir": "npm run typecheck && npm run build && npm run build:electron && electron-builder --dir",
    "preview": "vite preview",
    "publish:site": "node scripts/publish-site.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware src vite.config.ts && oxlint --type-aware --tsconfig tsconfig.electron.json electron scripts tools",
    "lint:fix": "oxlint --type-aware --fix src vite.config.ts && oxlint --type-aware --fix --tsconfig tsconfig.electron.json electron scripts tools",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node tools/ci/checkVersion.ts",
    "icon": "electron scripts/build-icon.mjs"
  },
  "build": {
    "appId": "com.xantar.game",
    "productName": "Xantar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "identity": null
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "phaser": "^4.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
